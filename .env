# Example environment configuration file
# Copy this to .env and update with your actual values

# Sitemap settings
SITEMAP_SEED=https://example.com/sitemap.xml
DOMAIN_ALLOW=example.com
ALLOW_SUBDOMAINS=true
MAX_PATH_DEPTH=

# Crawl behavior
CONCURRENCY=20
HEADLESS=true
BYPASS_CACHE=true
REQUEST_TIMEOUT_MS=30000
MAX_PAGES=100000
PAGINATION_LIMIT=300
OUTPUT_FILE=crawl_output.json

# Login settings (set USE_LOGIN=true to enable)
USE_LOGIN=false
LOGIN_URL=
USERNAME=
PASSWORD=
USERNAME_SELECTOR=input[name="login"]
PASSWORD_SELECTOR=input[name="password"]
SUBMIT_SELECTOR=.button--icon--login
POST_LOGIN_READY_SELECTOR=.p-navgroup-link--user

# Politeness
DELAY_BETWEEN_PAGES_SEC=0.3